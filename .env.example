# --- Database --------------------------------------------------------------
# MariaDB connection string consumed by drizzle-kit and the runtime pool.
# Format: mysql://<user>:<password>@<host>:<port>/<database>
#
# Local dev (host MariaDB):     mysql://meal:meal@localhost:3306/meal_manager
# Docker compose (service db):  mysql://meal:meal@db:3306/meal_manager
DATABASE_URL="mysql://meal:meal@localhost:3306/meal_manager"

# --- Auth ------------------------------------------------------------------
# Secret used by nuxt-auth-utils to sign session cookies.
# MUST be at least 32 characters. Generate with: openssl rand -base64 48
NUXT_SESSION_PASSWORD=""

# --- AI (Anthropic) --------------------------------------------------------
# Recipe AI assistant (Claude Messages API). Read via runtimeConfig (server
# only) — the NUXT_ prefix is required for Nuxt to map them. NEVER exposed to
# the client. Leave the key empty to disable AI at runtime; access is also
# gated per account (users.ai_enabled, default false).
NUXT_ANTHROPIC_API_KEY=""
# Optional overrides (defaults shown):
# NUXT_ANTHROPIC_MODEL="claude-sonnet-4-6"
# NUXT_ANTHROPIC_CHAT_EFFORT="medium"     # low | medium | high | max
# NUXT_ANTHROPIC_IMPORT_EFFORT="low"      # low | medium | high | max
# NUXT_ANTHROPIC_PHOTO_EFFORT="low"       # low | medium | high | max

# Effort Anthropic pour le scan d'étiquette (low|medium|high|max)
NUXT_ANTHROPIC_LABEL_EFFORT=medium
# Répertoire de stockage des photos d'étiquettes (monter un volume en prod)
NUXT_WINE_LABEL_DIR=.data/wine-labels

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# Host/port the Nitro server binds to. The Docker image defaults to 0.0.0.0:3000.
HOST=0.0.0.0
PORT=3000

# --- Docker compose only ---------------------------------------------------
# Credentials the MariaDB container is initialised with. They must match the
# user/password embedded in DATABASE_URL above when running via compose.
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=meal_manager
MARIADB_USER=meal
MARIADB_PASSWORD=meal
