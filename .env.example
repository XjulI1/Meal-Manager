# --- Database --------------------------------------------------------------
# MariaDB connection string consumed by drizzle-kit and the runtime pool.
# Format: mysql://<user>:<password>@<host>:<port>/<database>
#
# Local dev (host MariaDB):     mysql://meal:meal@localhost:3306/meal_manager
# Docker compose (service db):  mysql://meal:meal@db:3306/meal_manager
DATABASE_URL="mysql://meal:meal@localhost:3306/meal_manager"

# --- Auth ------------------------------------------------------------------
# Secret used by nuxt-auth-utils to sign session cookies.
# MUST be at least 32 characters. Generate with: openssl rand -base64 48
NUXT_SESSION_PASSWORD=""

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# Host/port the Nitro server binds to. The Docker image defaults to 0.0.0.0:3000.
HOST=0.0.0.0
PORT=3000

# --- Docker compose only ---------------------------------------------------
# Credentials the MariaDB container is initialised with. They must match the
# user/password embedded in DATABASE_URL above when running via compose.
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=meal_manager
MARIADB_USER=meal
MARIADB_PASSWORD=meal
