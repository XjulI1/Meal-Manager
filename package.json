    "@nuxt/ui": "^4.8.2",
    "@pinia/nuxt": "^0.11.3",
    "@zxing/browser": "^0.2.0",
    "drizzle-orm": "^0.36.4",
    "heic-to": "^1.2.0",
    "mysql2": "^3.22.5",
    "nuxt": "^4.4.7",
    "nuxt-auth-utils": "^0.5.29",
    "pinia": "^3.0.4",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.6",
